APP_NAME=Enterprise RAG Platform
APP_ENV=dev
LOG_LEVEL=INFO

# Authentication: api_key for local demo, oidc for enterprise-style JWT validation.
AUTH_MODE=api_key
RAG_API_KEY=change-me
DEFAULT_TENANT_ID=demo
OIDC_ISSUER=http://localhost:8080/realms/enterprise-rag
OIDC_AUDIENCE=enterprise-rag-api
OIDC_JWKS_URL=http://keycloak:8080/realms/enterprise-rag/protocol/openid-connect/certs
OIDC_ROLES_CLAIM=realm_access.roles
OIDC_TENANT_CLAIM=tenant_id

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enterprise_rag
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

OBJECT_STORE_ENABLED=true
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=enterprise-rag
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minio-change-me
S3_SECURE=false
OBJECT_STORE_STARTUP_RETRIES=15

LITELLM_MASTER_KEY=sk-change-me
LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=sk-change-me
LLM_MODEL=enterprise-rag
LLM_TEMPERATURE=0.1

# Optional separate evaluator model; blank values fall back to the primary LLM.
EVALUATOR_LLM_BASE_URL=
EVALUATOR_LLM_API_KEY=
EVALUATOR_LLM_MODEL=

CHUNK_SIZE=900
CHUNK_OVERLAP=150
VECTOR_TOP_K=10
LEXICAL_TOP_K=10
FINAL_TOP_K=5
MAX_UPLOAD_MB=20
MAX_BATCH_FILES=20

CACHE_ENABLED=true
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

POSTGRES_PASSWORD=rag-change-me
AUDIT_ENABLED=true
POSTGRES_DSN=postgresql://rag:rag-change-me@postgres:5432/rag

OTEL_ENABLED=true
OTEL_SERVICE_NAME=enterprise-rag-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
